<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>The Shattered Kingdoms — Referee Console</title>
    <style>
      :root { color-scheme: dark; }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: #14161a; color: #cfd3da;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 14px; line-height: 1.5;
      }
      main { max-width: 1180px; margin: 0 auto; padding: 1.5rem 1rem 4rem; }
      h1 { font-size: 1.3rem; color: #e8d9a8; letter-spacing: 0.04em; }
      h2 { font-size: 1.05rem; color: #b9c2cf; margin-top: 2rem; }
      a { color: #8fb7e8; text-decoration: none; }
      a:hover { text-decoration: underline; }
      label { display: block; margin: 0.6rem 0 0.15rem; color: #9aa3af; font-size: 0.85rem; }
      input[type=text], input[type=number], textarea {
        width: 100%; background: #1c1f25; color: #e6e8ec;
        border: 1px solid #343943; border-radius: 4px; padding: 0.4rem 0.5rem;
        font: inherit;
      }
      textarea { min-height: 5.5rem; }
      button {
        background: #2c3a2e; color: #d8e8d0; border: 1px solid #4a5f4c;
        border-radius: 4px; padding: 0.4rem 0.9rem; font: inherit; cursor: pointer;
      }
      button:hover { background: #37493a; }
      button.secondary { background: #262b33; color: #b9c2cf; border-color: #3b424e; }
      .log { list-style: none; margin: 0.5rem 0; padding: 0; border: 1px solid #2a2e36; border-radius: 4px; }
      .log > li {
        padding: 0.35rem 0.6rem; border-bottom: 1px solid #232730;
        white-space: pre-wrap; overflow-wrap: anywhere;
      }
      .log > li:last-child { border-bottom: none; }
      .log .meta { color: #6f7885; font-size: 0.8rem; }
      .log .kind-perception { color: #d6d9de; }
      .log .kind-ooc { color: #9a8fb8; font-style: italic; }
      .log .kind-dice { color: #8fb7e8; }
      .prompt-box { border: 1px solid #7a6a3a; background: #241f14; border-radius: 4px; padding: 0.6rem 0.8rem; margin: 0.6rem 0; color: #e8d9a8; }
      .flash-info { border: 1px solid #3c5a7a; background: #16222e; color: #a8c8e8; padding: 0.4rem 0.7rem; border-radius: 4px; margin: 0.4rem 0; }
      .flash-error { border: 1px solid #7a3c3c; background: #2e1616; color: #e8a8a8; padding: 0.4rem 0.7rem; border-radius: 4px; margin: 0.4rem 0; }
      table { border-collapse: collapse; width: 100%; }
      th, td { text-align: left; padding: 0.3rem 0.5rem; border-bottom: 1px solid #232730; vertical-align: top; }
      th { color: #9aa3af; font-weight: normal; font-size: 0.8rem; }
      .seat-grid { display: flex; gap: 0.6rem; flex-wrap: wrap; margin: 0.5rem 0 1rem; }
      .stat { display: inline-block; border: 1px solid #343943; border-radius: 4px; padding: 0.15rem 0.5rem; margin-right: 0.4rem; color: #9aa3af; font-size: 0.8rem; }
      .stat b { color: #e6e8ec; font-weight: normal; }
      .row-box { border: 1px solid #2a2e36; border-radius: 4px; padding: 0.3rem 0.6rem; margin-bottom: 0.4rem; white-space: pre-wrap; overflow-wrap: anywhere; }

      /* Play surface & GM console — UX redesign (2026-08-20 spec). Class contract;
         surfaces use these, they do not add their own styles. */
      .layout-seat { display: grid; grid-template-columns: 190px 1fr 190px; gap: 0.8rem; align-items: start; }
      .layout-gm { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; align-items: start; }
      .panel { border: 1px solid #2a2e36; border-radius: 4px; padding: 0.5rem 0.7rem; margin-bottom: 0.8rem; }
      .panel > h3 { margin: 0 0 0.4rem; font-size: 0.78rem; color: #9aa3af; text-transform: uppercase; letter-spacing: 0.08em; font-weight: normal; }
      .status-ribbon { display: flex; gap: 0.9rem; align-items: baseline; border: 1px solid #343943; border-radius: 4px; padding: 0.3rem 0.7rem; margin: 0.4rem 0 0.8rem; color: #9aa3af; font-size: 0.85rem; }
      .status-ribbon b { color: #e8d9a8; font-weight: normal; }
      .dot-ok { color: #7ec98f; } .dot-warn { color: #e8c96a; } .dot-bad { color: #e88f8f; }
      .chips { display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 0.3rem 0; }
      .chip { background: #262b33; color: #b9c2cf; border: 1px solid #3b424e; border-radius: 10px; padding: 0.1rem 0.6rem; font-size: 0.85rem; cursor: pointer; }
      .chip:hover { border-color: #8fb7e8; color: #e6e8ec; }
      .chip.salient { border-color: #7a6a3a; color: #e8d9a8; }
      .palette { display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 0.5rem 0; }
      .palette button { background: #262b33; color: #b9c2cf; border-color: #3b424e; padding: 0.2rem 0.6rem; font-size: 0.85rem; }
      .compose { display: flex; gap: 0.5rem; margin-top: 0.3rem; }
      .compose input { flex: 1; }
      .hint { color: #6f7885; font-size: 0.8rem; margin-top: 0.25rem; }
      .chronicle { max-height: 18rem; overflow-y: auto; }
      .hpbar { border: 1px solid #343943; border-radius: 3px; height: 0.7rem; background: #1c1f25; overflow: hidden; margin: 0.2rem 0 0.4rem; }
      .hpbar > div { height: 100%; background: #4a7c59; }
      .hpbar.low > div { background: #a85454; }
      .party-row { display: flex; justify-content: space-between; gap: 0.5rem; padding: 0.15rem 0; border-bottom: 1px solid #232730; }
      .flow-row { display: flex; justify-content: space-between; gap: 0.6rem; padding: 0.35rem 0.5rem; border-bottom: 1px solid #232730; }
      .flow-row.needs { border-left: 3px solid #e8c96a; padding-left: 0.4rem; }
      .lever-row { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 0.5rem 0; }
      .scenario-card { border: 1px solid #3b424e; border-radius: 6px; padding: 0.8rem 1rem; margin: 0.6rem 0; background: #181b21; }
      .seat-links input { width: 100%; font-size: 0.85rem; }
      details.advanced { margin: 0.6rem 0; }
      details.advanced summary { cursor: pointer; color: #9aa3af; }
      .roster-row { display: grid; grid-template-columns: repeat(8, 1fr); gap: 0.3rem; margin-bottom: 0.3rem; }
      .ledger-preview { list-style: none; margin: 0.3rem 0; padding: 0; border: 1px solid #2a2e36; border-radius: 4px; max-height: 22rem; overflow-y: auto; }
      .ledger-preview > li { padding: 0.25rem 0.6rem; border-bottom: 1px solid #232730; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 0.85rem; }
      .ledger-preview > li:last-child { border-bottom: none; }
      .ledger-preview .lc-narration { color: #d6d9de; }
      .ledger-preview .lc-dice { color: #8fb7e8; }
      .ledger-preview .lc-llm { color: #9a8fb8; }
      .ledger-preview .lc-meta { color: #6f7885; }
      .ledger-preview .lc-world { color: #7ec98f; }
      .dim { color: #6f7885; }

      /* GM console redesign (Task 4): round loop, party vitals, dungeon
         overview, GM chat, and collapsible diagnostics. */
      .lever-row { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 0.5rem 0 0.8rem; }
      .lever-row button { font-size: 0.95rem; }
      .lever-row button[data-testid="advance"] { background: #3d2e1c; color: #f0d49a; border-color: #7a6a3a; font-weight: bold; }
      .lever-row button[data-testid="advance"]:hover { background: #4a3a24; }
      .lever { display: flex; flex-direction: column; align-items: flex-start; gap: 0.25rem; }
      .lever-subtitle { margin: 0; font-size: 0.75rem; color: #9aa3af; max-width: 18rem; }
      .lever .badge.readiness { font-size: 0.75rem; background: #262b33; color: #9edab0; border: 1px solid #2d5a45; border-radius: 4px; padding: 0.05rem 0.35rem; }
      .status-ribbon .badge { border: 1px solid #2a2e36; border-radius: 4px; padding: 0.1rem 0.5rem; }
      .status-ribbon .badge b { color: #f0d49a; }
      .flow-list { list-style: none; margin: 0.5rem 0 0; padding: 0; }
      .flow-card-outer { display: flex; align-items: flex-start; gap: 0.5rem; border: 1px solid #2a2e36; border-radius: 6px; padding: 0.5rem 0.7rem; margin-bottom: 0.5rem; }
      .flow-card-outer.needs { border-left: 4px solid #e8c96a; }
      .flow-card-outer.ready { border-left: 4px solid #7ec98f; }
      .flow-card-outer.idle { border-left: 4px solid #6f7885; }
      .seat-dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: #6f7885; margin-top: 0.35rem; flex-shrink: 0; }
      .seat-dot[data-seated="true"] { background: #7ec98f; }
      .flow-card { flex: 1; }
      .pc-name { color: #e6e8ec; font-size: 1rem; }
      .flow-card .location { color: #9aa3af; font-size: 0.8rem; margin: 0.05rem 0 0.2rem; }
      .flow-card .badge { border-radius: 4px; padding: 0.05rem 0.35rem; font-size: 0.75rem; font-style: normal; font-weight: bold; margin-right: 0.35rem; }
      .flow-card .badge-prompt { background: #3a2e1c; color: #f0d49a; border: 1px solid #7a6a3a; }
      .flow-card .badge-ready { background: #1c3a2e; color: #9edab0; border: 1px solid #2d5a45; }
      .flow-card .badge-thinking { background: #262b33; color: #9aa3af; border: 1px solid #3b424e; }
      .flow-card .intent { display: block; color: #b9c2cf; margin: 0.15rem 0; }
      .flow-card .prompt { display: block; color: #e8c96a; margin: 0.15rem 0; font-style: italic; }
      .flow-card .hpbar { width: 100%; height: 0.5rem; background: #2a2e36; border-radius: 3px; overflow: hidden; margin: 0.35rem 0; }
      .flow-card .hpbar > div { height: 100%; background: #7ec98f; border-radius: 3px; }
      .flow-card .vitals { color: #9aa3af; font-size: 0.8rem; }
      .flow-card .vitals .stat { margin-left: 0.5rem; }
      .dungeon-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.7rem; margin-top: 0.5rem; }
      .room-card { border: 1px solid #2a2e36; border-radius: 6px; padding: 0.6rem 0.8rem; background: #181b21; }
      .room-card h3 { margin: 0 0 0.15rem; font-size: 0.95rem; color: #e8d9a8; }
      .room-card .residents { list-style: none; margin: 0.4rem 0; padding: 0; }
      .room-card .residents li { margin: 0.2rem 0; }
      .room-card .residents .badge { border-radius: 4px; padding: 0.05rem 0.35rem; font-size: 0.8rem; }
      .room-card .residents .badge.pc { background: #1c3a2e; color: #9edab0; border: 1px solid #2d5a45; }
      .room-card .residents .badge.monster { background: #3a1c1c; color: #e8a8a8; border: 1px solid #5a2d2d; }
      .room-card .exits { list-style: none; margin: 0.3rem 0 0; padding: 0; font-size: 0.8rem; color: #9aa3af; }
      .room-card .exits li { margin: 0.15rem 0; }
      .room-card .items,
      .room-card .hazards { list-style: none; margin: 0.3rem 0 0; padding: 0; font-size: 0.8rem; }
      .room-card .items li,
      .room-card .hazards li { margin: 0.2rem 0; }
      .room-card .badge { border-radius: 4px; padding: 0.05rem 0.35rem; font-size: 0.75rem; font-weight: bold; margin-right: 0.35rem; }
      .room-card .badge.treasure { background: #3a3a1c; color: #e8d9a8; border: 1px solid #7a6a3a; }
      .room-card .badge.hazard { background: #3a1c1c; color: #e8a8a8; border: 1px solid #5a2d2d; }
      .room-card .badge.hidden { background: #262b33; color: #9aa3af; border: 1px solid #3b424e; }
      .room-card .badge.carried { background: #1c3a2e; color: #9edab0; border: 1px solid #2d5a45; }
      .room-card .badge.armed { background: #3a2e1c; color: #f0d49a; border: 1px solid #7a6a3a; }
      .room-card .badge.triggered { background: #5a2d2d; color: #e8a8a8; border: 1px solid #7a3c3c; }
      .room-card .badge.sealed { background: #1c2233; color: #8fb7e8; border: 1px solid #3c5a7a; }
      .gm-rail .chronicle { max-height: 22rem; overflow-y: auto; }
      details.diagnostics { margin: 0.8rem 0; border: 1px solid #2a2e36; border-radius: 4px; padding: 0.4rem 0.7rem; }
      details.diagnostics summary { cursor: pointer; color: #9aa3af; font-size: 0.9rem; }
      details.diagnostics[open] summary { margin-bottom: 0.6rem; }
      .diagnostics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
      .diagnostics-grid .panel { margin-bottom: 0; }
      .boundary-table td { vertical-align: middle; }
      .boundary { font-size: 0.8rem; border-radius: 4px; padding: 0.05rem 0.35rem; }
      .boundary.state-active { background: #3a2e1c; color: #f0d49a; border: 1px solid #7a6a3a; }
      .boundary.state-inactive { background: #262b33; color: #9aa3af; border: 1px solid #3b424e; }
      .error { color: #e88f8f; }
      @media (max-width: 900px) {
        .layout-seat, .layout-gm, .diagnostics-grid { grid-template-columns: 1fr; }
        .roster-row { grid-template-columns: repeat(4, 1fr); }
      }
    </style>
    <script defer src="/assets/phoenix.min.js"></script>
    <script defer src="/assets/phoenix_live_view.min.js"></script>
    <script>
      // Chronicle auto-scroll (UX spec §4): stream updates pin the newest
      // row into view; a player who scrolled up is not yanked (only the
      // stream container itself scrolls, and only forward).
      window.addEventListener("DOMContentLoaded", () => {
        const liveSocket = new LiveView.LiveSocket("/live", Phoenix.Socket, {
          params: { _csrf_token: document.querySelector("meta[name='csrf-token']")?.content },
          hooks: {
            ChronicleScroll: {
              mounted() { this.el.scrollTop = this.el.scrollHeight; },
              updated() { this.el.scrollTop = this.el.scrollHeight; }
            }
          }
        });
        liveSocket.connect();
      });
    </script>
  </head>
  <body>
    <main>
      <.flash_group flash={@flash} />
      <%= @inner_content %>
    </main>
  </body>
</html>
