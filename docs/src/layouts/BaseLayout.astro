---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/tokens.css';
import '../styles/fantasy-fx.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Documentation for The Shattered Kingdoms engine and roleplaying platform.',
} = Astro.props;

const siteTitle = 'The Shattered Kingdoms';
const pageTitle = title ? `${title} — ${siteTitle}` : siteTitle;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="ember-overlay ember-particles" aria-hidden="true"></div>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  html {
    min-height: 100%;
    scroll-behavior: smooth;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;
  }

  .ember-overlay {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  main {
    position: relative;
    flex: 1 0 auto;
    width: 100%;
  }
</style>
