---
import { getCollection } from 'astro:content';

interface Props {
  currentSlug?: string;
  class?: string;
}

const { currentSlug, class: className = '' } = Astro.props;

const docs = await getCollection('docs');

const categoryOrder = [
  'Foundation',
  'Architecture',
  'Agents & Referee',
  'Protocol & Tooling',
  'Ecosystem',
] as const;

type Category = (typeof categoryOrder)[number];

const grouped = new Map<Category, typeof docs>();
categoryOrder.forEach((cat) => grouped.set(cat, []));

docs.forEach((doc) => {
  const category = doc.data.category as Category;
  if (!grouped.has(category)) {
    grouped.set(category, []);
  }
  grouped.get(category)!.push(doc);
});

grouped.forEach((list) => {
  list.sort((a, b) => {
    if (a.data.order !== b.data.order) return a.data.order - b.data.order;
    return a.data.title.localeCompare(b.data.title);
  });
});
---

<aside class:list={['sidebar', className]} aria-label="Documentation navigation">
  <div class="sidebar-header">
    <h2 class="sidebar-title">Tome of Knowledge</h2>
    <p class="sidebar-subtitle">The Age of Reclamation</p>
  </div>

  <nav class="sidebar-nav" aria-label="Docs sections">
    {
      docs.length === 0 ? (
        <p class="sidebar-empty">No chronicles have been bound yet.</p>
      ) : (
        categoryOrder.map((category) => {
          const list = grouped.get(category) ?? [];
          if (list.length === 0) return null;
          return (
            <section class="sidebar-section">
              <h3 class="sidebar-category">{category}</h3>
              <ul class="sidebar-list">
                {list.map((doc) => {
                  const isActive = doc.slug === currentSlug;
                  return (
                    <li class="sidebar-item">
                      <a
                        class:list={['sidebar-link', { active: isActive }]}
                        href={`/docs/${doc.slug}`}
                        aria-current={isActive ? 'page' : undefined}
                      >
                        <span class="sidebar-link-title">{doc.data.title}</span>
                        {doc.data.tags.includes('draft') && (
                          <span class="sidebar-link-tag">Draft</span>
                        )}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          );
        })
      )
    }
  </nav>
</aside>

<style>
  .sidebar {
    width: var(--sidebar-width, 18rem);
    height: calc(100vh - var(--header-height, 4rem));
    position: sticky;
    top: var(--header-height, 4rem);
    overflow-y: auto;
    padding: 1.25rem var(--content-padding, 1.5rem) 2rem;
    border-right: 1px solid var(--border-stone-subtle, #161d2a);
    background: color-mix(in srgb, var(--bg-surface, #0c1017) 96%, transparent);
  }

  .sidebar-header {
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-stone, #242e40);
  }

  .sidebar-title {
    margin: 0;
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--gold-bright, #f6d88e);
  }

  .sidebar-subtitle {
    margin: 0.25rem 0 0;
    font-size: 0.8rem;
    font-style: italic;
    color: var(--parchment-bg, #f5eedb);
    opacity: 0.65;
  }

  .sidebar-section {
    margin-bottom: 1.5rem;
  }

  .sidebar-category {
    margin: 0 0 0.5rem;
    font-family: var(--font-display, Georgia, serif);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--amber-rune, #ff9d42);
  }

  .sidebar-list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    list-style: none;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.625rem;
    font-size: 0.9rem;
    line-height: 1.35;
    color: var(--parchment-bg, #f5eedb);
    text-decoration: none;
    border-radius: var(--radius-sm, 0.25rem);
    border-left: 2px solid transparent;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .sidebar-link:hover,
  .sidebar-link:focus {
    color: var(--gold-bright, #f6d88e);
    background: var(--bg-surface-raised, #131822);
    border-left-color: var(--gold-deep, #8c6721);
  }

  .sidebar-link.active {
    color: var(--gold-bright, #f6d88e);
    background: var(--bg-surface-raised, #131822);
    border-left-color: var(--gold-primary, #dfb15b);
    box-shadow: var(--shadow-gold-sm, 0 0 0.5rem var(--gold-glow, rgba(223, 177, 91, 0.4)));
  }

  .sidebar-link-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sidebar-link-tag {
    flex-shrink: 0;
    padding: 0.15em 0.35em;
    font-family: var(--font-mono, monospace);
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--bg-void, #06080c);
    background: var(--crimson-blood, #e05238);
    border-radius: var(--radius-sm, 0.25rem);
  }

  .sidebar-empty {
    font-size: 0.9rem;
    font-style: italic;
    color: var(--parchment-bg, #f5eedb);
    opacity: 0.7;
  }

  @media (max-width: 1024px) {
    .sidebar {
      width: var(--sidebar-width-narrow, 16rem);
    }
  }
</style>
