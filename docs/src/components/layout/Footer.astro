---
import Icon from '../icons/Icons.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const year = new Date().getFullYear();

const links = [
  { label: 'Handbook', href: '/docs/01-overview' },
  { label: 'Pipeline', href: '/visualizers/referee' },
  { label: 'Dice 3D', href: '/visualizers/dice' },
  { label: 'Ledger', href: '/visualizers/replay' },
  { label: 'BDI Brains', href: '/visualizers/brains' },
  { label: 'Dungeon Map', href: '/visualizers/dungeon' },
];

const githubUrl = 'https://github.com/stevebrownlee/aeldoroth';
---

<footer class:list={['site-footer', className]}>
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="footer-mark"><Icon name="d20" size={20} /></span>
      <span class="footer-title">The Shattered Kingdoms</span>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <ul class="footer-list">
        {
          links.map((link) => (
            <li class="footer-item">
              <a class="footer-link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="footer-meta">
      <a class="footer-source" href={githubUrl} target="_blank" rel="noopener noreferrer">
        <Icon name="terminal" size={14} />
        GitHub
      </a>
      <span class="footer-copy">© {year} The Shattered Kingdoms. Forged in the Age of Reclamation.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-block: 2rem;
    border-top: 1px solid var(--border-stone-subtle, #161d2a);
    background: var(--bg-surface, #0c1017);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: var(--content-max-width, 80rem);
    margin-inline: auto;
    padding-inline: var(--content-padding, 1.5rem);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--gold-primary, #dfb15b);
  }

  .footer-mark {
    display: flex;
    color: var(--gold-primary, #dfb15b);
  }

  .footer-title {
    font-family: var(--font-display, Georgia, serif);
    font-size: 1rem;
    font-weight: 600;
  }

  .footer-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    list-style: none;
  }

  .footer-link {
    font-size: 0.85rem;
    color: var(--parchment-bg, #f5eedb);
    text-decoration: none;
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .footer-link:hover,
  .footer-link:focus {
    color: var(--gold-bright, #f6d88e);
    text-shadow: 0 0 0.5rem var(--gold-glow, rgba(223, 177, 91, 0.4));
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--parchment-bg, #f5eedb);
    opacity: 0.75;
  }

  .footer-source {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--gold-bright, #f6d88e);
    text-decoration: none;
  }

  .footer-source:hover,
  .footer-source:focus {
    text-decoration: underline;
  }

  .footer-copy {
    font-family: var(--font-mono, monospace);
  }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }

    .footer-meta {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
