---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DiceRoller3D from '../../components/visualizers/DiceRoller3D.astro';
---

<BaseLayout
  title="Arcane Dice Engine"
  description="Interactive 3D CSS dice roller with THAC0 target calculation for The Shattered Kingdoms."
>
  <article class="visualizer-page">
    <nav aria-label="Breadcrumb" class="breadcrumbs">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/visualizers">Visualizers</a></li>
        <li aria-current="page">Arcane Dice Engine</li>
      </ol>
    </nav>

    <header class="page-header">
      <h1 class="page-title">Arcane Dice Engine</h1>
      <p class="lead">
        This page simulates polyhedral dice as 3D CSS solids with deterministic
        fallbacks. The THAC0 calculator translates legacy attack tables into target
        numbers, showing how a d20 roll, modifiers, and armor class resolve to hit
        in a single animated throw.
      </p>
    </header>

    <DiceRoller3D />
  </article>
</BaseLayout>

<style>
  .visualizer-page {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: calc(var(--header-height) + 2rem) var(--content-padding) 3rem;
  }

  .breadcrumbs {
    margin-bottom: 1.5rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--gold-deep);
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumbs li:not(:last-child)::after {
    content: '›';
    margin-left: 0.5rem;
    color: var(--border-stone);
  }

  .breadcrumbs a {
    color: var(--gold-primary);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--gold-bright);
    text-decoration: underline;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--gold-primary);
    text-shadow: var(--shadow-gold-sm);
  }

  .lead {
    max-width: 64ch;
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--parchment-muted);
  }
</style>
